#!/bin/sh
set -eu
HOST=${FOG_HOST:-cpli.dev}
DIR=$(dirname "$0")
SRC=.cache/fog # on $HOST, relative to home
ATTR=config.system.build.toplevel

usage() {
	cat >&2 <<EOF
$0 build [-l]
$0 plan [-l]
$0 deploy [-l] [switch|boot|test|dry-activate]
$0 ratify
$0 publish <site> <dir>
$0 sites [rollback <host>]
$0 pin <name> <owner/repo> <branch>
$0 tofu ...
$0 witness

-l builds locally and copies the closure to $HOST, whose
   nix-daemon substitutes whatever cache.nixos.org already has

publish signs <dir> with git's gpg.program and user.signingkey, or with
\$FOG_GPG and \$FOG_KEY; lemma0 decides by the signature whether it goes
live or to preview.<site>

witness writes where lemma0 mounts witness0 (lemma/witness0.json) and its
credentials, encrypted to lemma0 and lux (lemma/witness0.asc), from tofu's
state after an apply; commit both
EOF
	exit 1
}

# ship the working tree (tracked and untracked, minus ignored) to $HOST
sync() {
	git -C "$DIR" ls-files -z --cached --others --exclude-standard |
		tar -C "$DIR" -cf - --null --ignore-failed-read -T - |
		ssh "$HOST" -- "rm -rf $SRC && mkdir -p $SRC && tar -x -C $SRC"
}

# build on $HOST by default, print the system's store path
build() {
	if [ "${1-}" = -l ]; then
		sys=$(nix-build "$DIR" -A $ATTR --no-out-link)
		nix-copy-closure --use-substitutes --to "$HOST" "$sys" >&2
	else
		sync
		sys=$(ssh "$HOST" -- nix-build $SRC -A $ATTR --no-out-link)
	fi
	printf %s "$sys"
}

# root via a transient system unit; polkit lets wheel manage-units. output goes
# to the journal, not through ssh, so ^C or a dropped session (or dbus-broker
# reloading under systemd-run) only ends the log tail, never the activation.
# the fixed unit name doubles as a lock against concurrent activations.
privileged() {
	ssh "$HOST" -- "
		systemctl is-active -q fog-switch && {
			echo 'fog: an activation is still running; journalctl -fu fog-switch' >&2
			exit 1
		}
		systemctl reset-failed fog-switch 2>/dev/null
		since=\$(date +@%s)
		systemd-run --unit=fog-switch --quiet --no-ask-password --service-type=exec \
			-E LOCALE_ARCHIVE -E NIXOS_INSTALL_BOOTLOADER /bin/sh -c '$1' || exit
		journalctl -f -o cat -u fog-switch --since \$since & tail=\$!
		while systemctl is-active -q fog-switch; do sleep 1; done
		sleep 1; kill \$tail
		! systemctl is-failed -q fog-switch"
}

deploy() {
	where=
	[ "${1-}" = -l ] && { where=-l; shift; }
	action=${1:-switch} profile=
	case $action in
	switch|boot) profile=true ;;
	test|dry-activate) ;;
	*) usage ;;
	esac
	sys=$(build $where)
	[ -n "$profile" ] &&
		profile="$sys/sw/bin/nix-env -p /nix/var/nix/profiles/system --set $sys &&"
	privileged "$profile exec $sys/bin/switch-to-configuration $action"
}

# sign "ecdo <site>\n" and the tarball, and send ecdo the signature, then
# the tarball (lemma/ecdo.nix)
publish() {
	[ $# -eq 2 ] && [ -d "$2" ] || usage
	gpg=${FOG_GPG:-$(git -C "$DIR" config gpg.program || echo gpg)}
	key=${FOG_KEY-$(git -C "$DIR" config user.signingkey || :)}
	tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
	tar -C "$2" -cf "$tmp/tar" .
	{ printf 'ecdo %s\n' "$1"; cat "$tmp/tar"; } |
		"$gpg" ${key:+-u "$key"} --detach-sign --armor >"$tmp/sig"
	cat "$tmp/sig" "$tmp/tar" | ssh "ecdo@$HOST" publish "$1"
}

pin() {
	[ $# -eq 3 ] || usage
	rev=$(git ls-remote "https://github.com/$2" "refs/heads/$3" | cut -f1)
	[ -n "$rev" ] || { echo "$0: no branch $3 in $2" >&2; exit 1; }
	url=https://github.com/$2/archive/$rev.tar.gz
	sha256=$(nix-prefetch-url --unpack --name source "$url")
	jq --arg n "$1" --arg url "$url" --arg sha256 "$sha256" \
		'.[$n] = {$url, $sha256}' "$DIR/pins.json" >"$DIR/pins.json.tmp"
	mv "$DIR/pins.json.tmp" "$DIR/pins.json"
}

# witness0's subaccount for lemma0, from tofu's state into the repository:
# where it is in the clear, how to log in encrypted
witness() {
	tofu -chdir="$DIR" output -json witness0_srv >"$DIR/lemma/witness0.json"
	tofu -chdir="$DIR" output -raw witness0_srv_credentials |
		sqop encrypt "$DIR/lemma/certs/lemma0.asc" "$DIR/lemma/certs/lux.asc" \
		>"$DIR/lemma/witness0.asc"
	echo "wrote lemma/witness0.json and lemma/witness0.asc; commit both" >&2
}

cmd=${1-}; [ $# -gt 0 ] && shift
case $cmd in
build) build "$@"; echo ;;
plan) sys=$(build "$@"); ssh "$HOST" -- nix store diff-closures /run/current-system "$sys" ;;
deploy) deploy "$@" ;;
ratify) ssh "$HOST" -- fog ratify ;;
publish) publish "$@" ;;
sites) [ $# -gt 0 ] || set -- list; ssh "ecdo@$HOST" "$@" ;;
pin) pin "$@" ;;
witness) witness ;;
tofu) TF_VAR_hcloud_token=$(p show com/hetzner | awk '$1=="api:" {print $2}') tofu "$@" ;;
*) usage ;;
esac
