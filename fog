#!/bin/sh
FQDN=cpli.dev
DIR=$(dirname "$0")

populate() {
	ssh $FQDN -- run0 su <<EOF
[ -d /run/fog ] && rm -r /run/fog
mkdir -p /run/fog
chown cpli:wheel /run/fog
EOF
	rsync -r "$DIR"/* $FQDN:/run/fog
}

pin() {
	[ ! $# -eq 2 ] && { echo "$0"' pin <repo> <branch>' >&2; exit 1; }
	repo=$1
	branch=$2
	ref=$(git ls-remote $repo "$branch" | awk 'NR==1{print $1}')
	set -- --name source --unpack --print-path "$repo"/archive/"$ref".tar.gz
	set -- $(ssh $FQDN nix-prefetch-url "$@")
	cat <<EOF
{
	"ref": "$ref",
	"sha256": "$1",
	"store-path": "$2",
}
EOF
}

case $1 in
''|--) nixos-rebuild switch -f /run/fog/default.nix;;
dry-run) populate; ssh $FQDN -- nixos-rebuild dry-run -f /run/fog/default.nix;;
deploy) populate; ssh $FQDN -- run0 /run/fog/fog "$@";;
populate) populate;;
pin) pin;;
esac
