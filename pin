#!/bin/sh
[ ! $# -eq 2 ] && { echo 'pin <repo> <branch>' >&2; exit 1; }
repo=$1
branch=$2
ref=$(git ls-remote $repo "$branch" | awk 'NR==1{print $1}')
url=$repo/archive/$ref.tar.gz
set -- $(nix-prefetch-url --name source --unpack --print-path "$url")
cat <<EOF
{
	"ref": "$ref",
	"sha256": "$1",
	"store-path": "$2",
}
EOF
